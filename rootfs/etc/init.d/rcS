#!/usr/bin/busybox-static sh
# ╔══════════════════════════════════════════════════════════════╗
# ║     Star-Talk / 星语 — System Init (rcS)                   ║
# ╚══════════════════════════════════════════════════════════════╝
#
# This script runs once at system boot (called from /etc/inittab).
# It initializes devices, loads modules, starts system services,
# and prepares the system for the user session.

echo ""
echo "  ╔══════════════════════════════════════════════════════════╗"
echo "  ║     Starting Star-Talk / 星語 ...                       ║"
echo "  ╚══════════════════════════════════════════════════════════╝"
echo ""

# ── Mount filesystems ────────────────────────────────────────────
echo "  * Mounting filesystems..."
mount -a

# ── Device nodes ─────────────────────────────────────────────────
echo "  * Populating device nodes..."
mdev -s
echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true

# ── Load kernel modules ──────────────────────────────────────────
echo "  * Loading kernel modules..."

# GPU drivers
modprobe i915 2>/dev/null && echo "    i915 (Intel GPU)" || true
modprobe amdgpu 2>/dev/null && echo "    amdgpu (AMD GPU)" || true
modprobe virtio-gpu 2>/dev/null && echo "    virtio-gpu" || true

# Audio
modprobe snd-hda-intel 2>/dev/null && echo "    snd-hda-intel" || true
modprobe snd-usb-audio 2>/dev/null && echo "    snd-usb-audio" || true

# Wi-Fi
modprobe iwlwifi 2>/dev/null && echo "    iwlwifi (Intel Wi-Fi)" || true
modprobe iwlmvm 2>/dev/null && echo "    iwlmvm (Intel Wi-Fi MVM)" || true

# USB
modprobe xhci-pci 2>/dev/null && echo "    xhci-pci" || true
modprobe ehci-pci 2>/dev/null && echo "    ehci-pci" || true

# Storage
modprobe usb-storage 2>/dev/null || true
modprobe nvme 2>/dev/null && echo "    nvme" || true

# Virtualization
modprobe virtio-blk 2>/dev/null || true
modprobe virtio-net 2>/dev/null || true
modprobe virtio-input 2>/dev/null || true

# ── Set hostname ─────────────────────────────────────────────────
hostname "$(cat /etc/hostname 2>/dev/null || echo 'startalk')"
echo "  * Hostname: $(hostname)"

# ── System parameters ────────────────────────────────────────────
# Kernel printk level
echo "3 4 1 3" > /proc/sys/kernel/printk 2>/dev/null || true

# ── Start D-Bus system bus ───────────────────────────────────────
echo "  * Starting D-Bus system bus..."
if [ -x /usr/bin/dbus-daemon ]; then
    dbus-daemon --system --fork
    echo "    D-Bus: running"
else
    echo "    D-Bus: not installed"
fi

# ── Start elogind (seat/session management for Wayland) ──────────
echo "  * Starting elogind..."
if [ -x /usr/libexec/elogind ]; then
    /usr/libexec/elogind &
    echo "    elogind: running"
elif [ -x /usr/libexec/elogind/elogind ]; then
    /usr/libexec/elogind/elogind &
    echo "    elogind: running"
else
    echo "    elogind: not installed (Wayland may need it)"
fi

# ── Start PipeWire (audio) ───────────────────────────────────────
echo "  * Starting PipeWire audio..."
if [ -x /usr/bin/pipewire ]; then
    # PipeWire is started per-user in startalk-session
    # but we can start the system-wide instance if needed
    echo "    PipeWire: will start per-user session"
else
    echo "    PipeWire: not installed"
fi

# ── Network (basic DHCP on wired interfaces) ─────────────────────
echo "  * Configuring network..."
ip link set lo up 2>/dev/null && echo "    lo: up" || true

# Try DHCP on first wired interface
for iface in eth0 enp0s3 ens3 enp0s1; do
    if ip link set "$iface" up 2>/dev/null; then
        echo "    $iface: up, requesting DHCP..."
        udhcpc -b -i "$iface" -x hostname:startalk 2>/dev/null &
        break
    fi
done

# ── Virtual console setup ────────────────────────────────────────
echo "  * Setting up virtual consoles..."
if [ -f /sys/class/tty/tty0/active ]; then
    echo "    Console: $(cat /sys/class/tty/tty0/active)"
fi

# ── Boot complete ────────────────────────────────────────────────
echo ""
echo "  ┌──────────────────────────────────────────────────────────┐"
echo "  │  Star-Talk initialization complete.                     │"
echo "  │  System ready.                                          │"
echo "  └──────────────────────────────────────────────────────────┘"
echo ""

exit 0
