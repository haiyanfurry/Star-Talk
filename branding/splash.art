# ── Phase-specific LED codes ───────────────────────────────────────────
# These mimic AIX front-panel LED diagnostic codes
STARTALK_LED_CODES="
L200:IPL ROM scan
L201:Firmware handoff
L210:Loading bootloader
L220:Loading kernel from FFSv2
L230:Kernel relocation
L240:Probing root device
L300:Kernel bootstrap complete
L400:Mounting root filesystem
L500:System initialization (rc)
L510:Hardware enumeration start
L511:CPU topology detection
L512:Memory sizing
L513:PCI bus scan
L514:USB subsystem init
L515:Storage controller probe
L516:GPU/DRM initialization
L517:Network interface detection
L518:Audio device probe
L520:Device configuration (devpubd)
L530:Filesystem check (fsck)
L540:Mounting filesystems
L550:Setting hostname
L600:Starting system services
L610:syslogd start
L620:dbus start
L630:dhcpcd / network
L640:sshd start
L700:Login services
L800:Desktop environment
L810:SDDM display manager
L820:KDE Plasma session
L900:System ready
"

# ── Color palette (Catppuccin Mocha inspired) ──────────────────────────
# Override these in /etc/rc.conf if desired
STARTALK_C_LOGO="\033[1;36m"      # Cyan — logo border
STARTALK_C_TITLE="\033[1;35m"     # Magenta — title
STARTALK_C_OK="\033[1;32m"        # Green — success
STARTALK_C_INFO="\033[1;33m"      # Yellow — info/warning
STARTALK_C_FAIL="\033[1;31m"      # Red — failure
STARTALK_C_HW="\033[0;36m"        # Dim cyan — hardware details
STARTALK_C_LED="\033[1;37m"       # White — LED codes
STARTALK_C_RESET="\033[0m"        # Reset all attributes
