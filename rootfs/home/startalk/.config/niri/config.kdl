// ╔══════════════════════════════════════════════════════════════╗
// ║     Star-Talk / 星语 — Niri Compositor Configuration       ║
// ║     Catppuccin Mocha Theme                                 ║
// ╚══════════════════════════════════════════════════════════════╝
//
// Niri is a scrollable-tiling Wayland compositor.
// Windows tile on an infinite horizontal ribbon;
// scroll left/right through workspaces.

// ── Output Configuration ──────────────────────────────────────
output "eDP-1" {
    // Built-in laptop display — auto-detected
    // mode auto (use preferred mode)
    // scale 1.0
}

output "HDMI-A-1" {
    // External display
}

output "DP-1" {
    // DisplayPort
}

// ── Input Configuration ────────────────────────────────────────
input {
    keyboard {
        xkb_layout "us"
        // Uncomment for Chinese input layout toggle:
        // xkb_options "grp:alt_shift_toggle"
        xkb_options "ctrl:nocaps"
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
        dwt  // disable-while-typing
        accel-speed 0.2
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    tablet {
        map-to-output "eDP-1"
    }
}

// ── Layout Configuration ───────────────────────────────────────
layout {
    // Default column size: 50% of output width
    default-column-width { proportion 0.5; }

    // Preset column widths cycled with Mod+R
    preset-column-widths {
        proportion 0.33333;
        proportion 0.5;
        proportion 0.66667;
    }

    // Gaps between windows
    gaps 8

    // Reserve space for waybar (top bar, 30px)
    struts {
        top 30
    }

    // Focus ring
    focus-ring {
        active-color "#cba6f7"  // Catppuccin Mauve
        active-width 2
        inactive-color "#45475a" // Catppuccin Surface1
        inactive-width 1
    }

    // New windows open to the right of the focused window
    insert-hint "right"
}

// ── Visual Configuration ───────────────────────────────────────
prefer-no-csd  // Prefer server-side decorations for consistency

hotkey-overlay {
    skip-at-startup
}

// Disable cursor warp on focus change (less jarring)
cursor {
    hide-after-inactive-ms 3000
}

// ── Keybindings ────────────────────────────────────────────────
// Super key = Mod (Windows/Command key)
binds {
    // ── Window Management ──
    Mod+Q       { close-window; }
    Mod+Shift+Q { quit; }
    Mod+Shift+C { close-window; }

    // ── Application Launchers ──
    Mod+Return  { spawn "foot"; }
    Mod+D       { spawn "wofi" "--show" "drun" "--prompt" "Star-Talk"; }
    Mod+Space   { spawn "wofi" "--show" "drun" "--prompt" "Star-Talk"; }
    Mod+R       { spawn "wofi" "--show" "run" "--prompt" "Run"; }

    // ── Navigation (scrollable-tiling) ──
    // Move focus between windows in a column
    Mod+J       { focus-window-down; }
    Mod+K       { focus-window-up; }

    // Move focus between columns (left/right)
    Mod+H       { focus-column-left; }
    Mod+L       { focus-column-right; }

    // Move windows within column
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // Move column left/right (reorder)
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }

    // Scroll workspace left/right (the "infinite ribbon")
    Mod+Left    { focus-workspace-previous; }
    Mod+Right   { focus-workspace-next; }

    // Direct workspace access (1-9)
    Mod+1       { focus-workspace 1; }
    Mod+2       { focus-workspace 2; }
    Mod+3       { focus-workspace 3; }
    Mod+4       { focus-workspace 4; }
    Mod+5       { focus-workspace 5; }
    Mod+6       { focus-workspace 6; }
    Mod+7       { focus-workspace 7; }
    Mod+8       { focus-workspace 8; }
    Mod+9       { focus-workspace 9; }

    // Move window to workspace
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // ── Column Resizing ──
    Mod+Minus   { set-column-width "-5%"; }
    Mod+Equal   { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // ── Fullscreen / Maximize ──
    Mod+F       { fullscreen-window; }
    Mod+Shift+F { maximize-column; }

    // ── Screen Lock ──
    Mod+Shift+L { spawn "swaylock" "-f" "-c" "1e1e2e"; }

    // ── Screenshot ──
    // Print     { spawn "grim" "/tmp/screenshot-$(date +%s).png"; }
    // Shift+Print { spawn "grim" "-g" "$(slurp)" "/tmp/screenshot-$(date +%s).png"; }

    // ── Volume Control (PipeWire/WirePlumber) ──
    XF86AudioRaiseVolume  { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute      { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // ── Brightness Control ──
    XF86MonBrightnessUp   { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }

    // ── Power / Session ──
    Mod+Shift+E { spawn "wlogout"; }

    // ── Tor Control ──
    Mod+Shift+T { spawn "foot" "-e" "nyx"; }  // Tor status monitor
}

// ── Animations ──────────────────────────────────────────────────
animations {
    slowdown-when-unfocused 0.5

    workspace-switch 300  // ms
    window-open 150
    window-close 150
    window-move 100
}

// ── Spawn at Startup ────────────────────────────────────────────
spawn-at-startup "swaybg" "-i" "/usr/share/wallpapers/star-talk-bg.png" "-m" "fill"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "foot" "--server"  // foot daemon for instant terminal spawn

// ── Screenshot path ─────────────────────────────────────────────
screenshot-path "/tmp"

// ── Environment ─────────────────────────────────────────────────
// These are set in /usr/local/bin/startalk-session before niri launches
// MOZ_ENABLE_WAYLAND=1    — Firefox on Wayland natively
// QT_QPA_PLATFORM=wayland — Qt apps on Wayland
// GDK_BACKEND=wayland     — GTK apps on Wayland
// SDL_VIDEODRIVER=wayland — SDL2 games on Wayland
