# ╔══════════════════════════════════════════════════════════════════════╗
# ║          Star-Talk / 星语 — ASCII Art Boot Splash                 ║
# ║          NetBSD-based Desktop Operating System                     ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# This ASCII art is displayed during early boot by /etc/rc.d/startalk-splash.
# Inspired by AIX boot diagnostic panels — each "LED code" represents
# a boot phase, printed in color-coded format.
#
# Format: L[CODE] [STATUS] — Description
# Colors: CYAN=header, GREEN=OK, YELLOW=info, RED=failure, WHITE=highlight

# ── Primary ASCII Logo ─────────────────────────────────────────────────
STARTALK_LOGO='
    ╔══════════════════════════════════════════════════════════════╗
    ║                                                              ║
    ║          .d8888b.  888                      888    888       ║
    ║         d88P  Y88b 888                      888    888       ║
    ║         Y88b.      888                      888    888       ║
    ║          "Y888b.   888888  8888b.  888d888  888888 888  888  ║
    ║             "Y88b. 888        "88b 888P"    888    888  888  ║
    ║               "888 888    .d888888 888      888    888  888  ║
    ║         Y88b  d88P Y88b.  888  888 888      Y88b.  Y88b 888  ║
    ║          "Y8888P"   "Y888 "Y888888 888       "Y888  "Y88888  ║
    ║                                                              ║
    ║             ★  Welcome to Star-Talk / 星 语  ★               ║
    ║             NetBSD Kernel — KDE Plasma Desktop               ║
    ║                                                              ║
    ╚══════════════════════════════════════════════════════════════╝'

# ── Compact Logo (for narrow terminals / serial console) ───────────────
STARTALK_LOGO_COMPACT='
  ╔══════════════════════════════════════════╗
  ║  .d8888b.  888      888    888          ║
  ║ d88P  Y88b 888      888    888          ║
  ║ Y88b.      888      888    888          ║
  ║  "Y888b.   888888  888888 888  888      ║
  ║     "Y88b. 888    888    888  888        ║
  ║       "888 888    888    888  888        ║
  ║ Y88b  d88P Y88b.  Y88b.  Y88b 888       ║
  ║  "Y8888P"   "Y888  "Y888  "Y88888       ║
  ║                                          ║
  ║   ★ Star-Talk / 星 语 ★                 ║
  ║   NetBSD + KDE Plasma                   ║
