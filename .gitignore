/rootfs/

# NetBSD build outputs
work/netbsd-src/
work/netbsd-obj/
work/netbsd-tools/
work/netbsd-dest/
work/pkgsrc/
work/rootfs-staging/

# Kernel build artifacts
out/netbsd
out/star-talk-netbsd-*.img

# Downloaded archives
*.tar.*
*.tar
*.tgz
*.zip
!src/tarballs/*.tar.*
!src/tarballs/*.tar
!src/tarballs/*.tgz
!src/tarballs/*.zip

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS noise
.DS_Store
Thumbs.db

# Disk images
*.img

# Linux legacy artifacts (from v1.x)
/initramfs/bin/busybox
/out/bzImage
/out/initramfs.cpio.zst
/out/initramfs.cpio
