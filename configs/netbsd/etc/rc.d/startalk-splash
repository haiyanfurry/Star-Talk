#!/bin/sh
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Star-Talk / 星语 — /etc/rc.d/startalk-splash                     ║
# ║  AIX-style boot splash with hardware detection + ASCII art        ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# Runs early in the boot sequence (BEFORE LOGIN).
# Displays:
#   1. ASCII art "Star-Talk / 星语" logo
#   2. Hardware detection panel (CPU, RAM, GPU, disks, network)
#   3. Color-coded boot phase LEDs (AIX diagnostic style)
#   4. Kernel and system version info
#
# Controlled by: rc.conf → startalk_splash=YES|NO

# PROVIDE: startalk_splash
# REQUIRE: mountcritremote syslogd
# BEFORE:  LOGIN

$_rc_subr_loaded . /etc/rc.subr

name="startalk_splash"
rcvar=$name
start_cmd="startalk_splash_start"
stop_cmd=":"

# ── Color definitions (Catppuccin Mocha palette) ────────────────────────
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_BORDER='\033[1;36m'      # Cyan
C_LOGO='\033[1;35m'        # Magenta
C_OK='\033[1;32m'          # Green
C_INFO='\033[1;33m'        # Yellow
C_FAIL='\033[1;31m'        # Red
C_HW='\033[0;36m'          # Dim cyan
C_LED='\033[1;37m'         # White
C_TITLE='\033[1;33m'       # Yellow bold

# ── Hardware detection functions ────────────────────────────────────────
detect_cpu() {
    local cpu_model cpu_cores cpu_family cpu_freq
    # Try /proc/cpuinfo first (if procfs mounted)
    if [ -f /proc/cpuinfo ]; then
        cpu_model=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^[ \t]*//')
        cpu_cores=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    fi
    # Fallback: sysctl
    [ -z "$cpu_model" ] && cpu_model=$(/sbin/sysctl -n machdep.cpu_brand 2>/dev/null)
    [ -z "$cpu_cores" ] && cpu_cores=$(/sbin/sysctl -n hw.ncpu 2>/dev/null || echo "?")
    [ -z "$cpu_model" ] && cpu_model="Unknown CPU"
    echo "${cpu_model} (${cpu_cores} cores)"
}

detect_ram() {
    local total pagesize
    total=$(/sbin/sysctl -n hw.physmem 2>/dev/null)
    if [ -n "$total" ]; then
        echo "$(( total / 1024 / 1024 )) MB"
    else
        echo "unknown"
    fi
}

detect_gpu() {
    local gpu_info
    # Check for DRM devices
    if [ -d /sys/class/drm ]; then
        for card in /sys/class/drm/card*; do
            [ -d "$card" ] || continue
            local driver=$(cat "$card/device/uevent" 2>/dev/null | grep DRIVER= | cut -d= -f2)
            [ -n "$driver" ] && gpu_info="${gpu_info}${driver} "
        done
    fi
    # Fallback: dmesg
    [ -z "$gpu_info" ] && gpu_info=$(dmesg 2>/dev/null | grep -i "drm\|radeon\|amdgpu\|i915\|nouveau" | grep ":" | head -2 | sed 's/.*: //' | tr '\n' ' ')
    [ -z "$gpu_info" ] && gpu_info="probing..."
    echo "$gpu_info"
}

detect_disks() {
    local disk_info
    # Scan for wd (IDE/SATA), sd (SCSI/USB), ld (virtio), nvme
    disk_info=$(dmesg 2>/dev/null | grep -E "^(wd|sd|ld|nvme)[0-9]+:.*<(.*)>" | \
        sed 's/.*<\(.*\)>.*/\1/' | tr '\n' ',' | sed 's/,$//')
    [ -z "$disk_info" ] && disk_info=$(/sbin/sysctl -n hw.disknames 2>/dev/null | sed 's/ /,/g')
    [ -z "$disk_info" ] && disk_info="detecting..."
    echo "$disk_info"
}

detect_network() {
    local net_ifaces iface_out
    net_ifaces=$(/sbin/ifconfig -l 2>/dev/null | tr ' ' '\n' | grep -v "^lo" | tr '\n' ' ')
    [ -z "$net_ifaces" ] && net_ifaces=$(dmesg 2>/dev/null | grep "Ethernet address" | sed 's/:.*//' | tr '\n' ' ')
    # Truncate to first 3
    iface_out=$(echo "$net_ifaces" | awk '{for(i=1;i<=3 && i<=NF;i++) printf "%s ", $i}')
    [ -z "$iface_out" ] && iface_out="none detected"
    echo "$iface_out"
}

detect_audio() {
    local audio_dev
    audio_dev=$(dmesg 2>/dev/null | grep -E "audio[0-9]+ at" | sed 's/:.*//' | tr '\n' ' ')
    [ -z "$audio_dev" ] && audio_dev=$(dmesg 2>/dev/null | grep -i "hdaudio\|uaudio" | grep "at" | sed 's/:.*//' | tr '\n' ' ')
    [ -z "$audio_dev" ] && audio_dev="detecting..."
    echo "$audio_dev"
}

# ── LED code display (AIX diagnostic style) ─────────────────────────────
print_led() {
    local code="$1" status="$2" desc="$3"
    printf "${C_LED}  [${B}%-4s${C_LED}]${C_RESET} ${status} ${C_DIM}— %s${C_RESET}\n" "$code" "$desc"
}

print_led_ok() {
    print_led "$1" "${C_OK}[ OK ]${C_RESET}" "$2"
}

print_led_info() {
    print_led "$1" "${C_INFO}[INFO]${C_RESET}" "$2"
}

print_led_fail() {
    print_led "$1" "${C_FAIL}[FAIL]${C_RESET}" "$2"
}

# ── Main splash function ────────────────────────────────────────────────
startalk_splash_start() {
    local kernel_ver=$(/sbin/sysctl -n kern.osrelease 2>/dev/null || echo "NetBSD")
    local hostname=$(/sbin/sysctl -n kern.hostname 2>/dev/null || echo "startalk")
    local arch=$(/sbin/sysctl -n hw.machine_arch 2>/dev/null || uname -m)
    local uptime_sec=$(/sbin/sysctl -n kern.boottime 2>/dev/null | awk '{print $1}' || echo "0")

    # Only display on console (ttyE0), not on serial or SSH
    case "$(tty 2>/dev/null)" in
        /dev/ttyE0|/dev/ttyE1|/dev/console|/dev/ttyv0)
            ;;
        *)
            return 0
            ;;
    esac

    clear 2>/dev/null || printf '\033[2J\033[H'

    # ── ASCII Art Logo ────────────────────────────────────────────────
    printf "${C_BORDER}"
    printf "  ╔══════════════════════════════════════════════════════════════╗\n"
    printf "  ║                                                              ║\n"
    printf "  ║${C_LOGO}         .d8888b.  888                      888    888       ${C_BORDER}║\n"
    printf "  ║${C_LOGO}        d88P  Y88b 888                      888    888       ${C_BORDER}║\n"
    printf "  ║${C_LOGO}        Y88b.      888                      888    888       ${C_BORDER}║\n"
    printf "  ║${C_LOGO}         \"Y888b.   888888  8888b.  888d888  888888 888  888  ${C_BORDER}║\n"
    printf "  ║${C_LOGO}            \"Y88b. 888        \"88b 888P\"    888    888  888  ${C_BORDER}║\n"
    printf "  ║${C_LOGO}              \"888 888    .d888888 888      888    888  888  ${C_BORDER}║\n"
    printf "  ║${C_LOGO}        Y88b  d88P Y88b.  888  888 888      Y88b.  Y88b 888  ${C_BORDER}║\n"
    printf "  ║${C_LOGO}         \"Y8888P\"   \"Y888 \"Y888888 888       \"Y888  \"Y88888  ${C_BORDER}║\n"
    printf "  ║                                                              ║\n"
    printf "  ║${C_TITLE}            ★  Welcome to Star-Talk / 星 语  ★              ${C_BORDER}║\n"
    printf "  ║${C_INFO}            NetBSD ${kernel_ver} — ${arch} Architecture           ${C_BORDER}║\n"
    printf "  ║${C_INFO}            KDE Plasma Desktop Environment                    ${C_BORDER}║\n"
    printf "  ║                                                              ║\n"
    printf "  ╚══════════════════════════════════════════════════════════════╝\n"
    printf "${C_RESET}\n"

    # ── AIX-Style LED Diagnostic Codes ─────────────────────────────────
    printf "${C_BORDER}  ┌── ${C_BOLD}Boot Diagnostics (L200-L900)${C_BORDER} ───────────────────────────┐\n"

    # Simulated LED sequence (these would be real-time in a full implementation)
    print_led_ok "L200" "IPL ROM — firmware handoff"
    print_led_ok "L220" "Bootloader — loaded kernel"
    print_led_ok "L240" "Kernel — probing root device"
    print_led_ok "L400" "Root filesystem — mounted"
    print_led_ok "L510" "Hardware enumeration"
    print_led_ok "L540" "Mounting filesystems"
    print_led_info "L600" "Starting system services"
    print_led_info "L700" "Login services ready"

    printf "${C_BORDER}  └──────────────────────────────────────────────────────────────┘\n${C_RESET}\n"

    # ── Hardware Detection Panel ───────────────────────────────────────
    printf "${C_BORDER}  ┌── ${C_BOLD}Hardware Detection${C_BORDER} ──────────────────────────────────────┐\n"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}CPU       :${C_RESET} %-47s ${C_BORDER}│\n" "$(detect_cpu)"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}Memory    :${C_RESET} %-47s ${C_BORDER}│\n" "$(detect_ram)"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}GPU       :${C_RESET} %-47s ${C_BORDER}│\n" "$(detect_gpu)"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}Disks     :${C_RESET} %-47s ${C_BORDER}│\n" "$(detect_disks)"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}Network   :${C_RESET} %-47s ${C_BORDER}│\n" "$(detect_network)"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}Audio     :${C_RESET} %-47s ${C_BORDER}│\n" "$(detect_audio)"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}Kernel    :${C_RESET} NetBSD %-43s ${C_BORDER}│\n" "${kernel_ver}"
    printf "${C_BORDER}  │${C_RESET}  ${C_OK}Hostname  :${C_RESET} %-47s ${C_BORDER}│\n" "${hostname}"
    printf "${C_BORDER}  └──────────────────────────────────────────────────────────────┘\n${C_RESET}\n"

    # ── Powered by lines ──────────────────────────────────────────────
    printf "${C_DIM}  Powered by NetBSD (pkgsrc) + KDE Plasma — https://star-talk.dev${C_RESET}\n"
    printf "${C_DIM}  Copyright (C) 2026 Hai Yan. Licensed under GPL-3.0${C_RESET}\n"
    printf "\n"

    return 0
}

load_rc_config $name
run_rc_command "$1"
