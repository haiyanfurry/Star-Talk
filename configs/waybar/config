{
    // ╔══════════════════════════════════════════════════════════════╗
    // ║     Star-Talk / 星语 — Waybar Configuration                ║
    // ║     Catppuccin Mocha Theme                                 ║
    // ╚══════════════════════════════════════════════════════════════╝

    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    // ── Left-aligned modules ──────────────────────────────────────
    "modules-left": [
        "custom/logo",
        "niri/workspaces"
    ],

    // ── Center modules ────────────────────────────────────────────
    "modules-center": [
        "clock"
    ],

    // ── Right-aligned modules ─────────────────────────────────────
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "custom/tor-status",
        "custom/i2p-status"
    ],

    // ── Custom Logo Module ────────────────────────────────────────
    "custom/logo": {
        "format": " 星语 ",
        "tooltip": false
    },

    // ── Niri Workspaces ───────────────────────────────────────────
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九"
        },
        "all-outputs": false,
        "active-only": false
    },

    // ── Clock ─────────────────────────────────────────────────────
    "clock": {
        "format": "{:%Y-%m-%d  %H:%M}",
        "format-alt": "{:%Y-%m-%d  %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // ── PulseAudio / PipeWire ────────────────────────────────────
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  MUTE ",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "foot -e pulsemixer",
        "tooltip-format": "{desc} — {volume}%"
    },

    // ── Network ───────────────────────────────────────────────────
    "network": {
        "format-wifi": "{signalStrength}%  {essid}",
        "format-ethernet": " LAN ",
        "format-disconnected": " NO NET ",
        "format-linked": " LINK ",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n↑{bandwidthUpBits} ↓{bandwidthDownBits}",
        "on-click": "foot -e nmtui"
    },

    // ── CPU ───────────────────────────────────────────────────────
    "cpu": {
        "format": " CPU {usage}% ",
        "tooltip": true,
        "on-click": "foot -e btop"
    },

    // ── Memory ────────────────────────────────────────────────────
    "memory": {
        "format": " RAM {percentage}% ",
        "tooltip": true
    },

    // ── Tor Status Indicator ─────────────────────────────────────
    "custom/tor-status": {
        "exec": "/home/startalk/bin/tor-status.sh",
        "interval": 10,
        "return-type": "json",
        "format": " {} ",
        "tooltip": true,
        "on-click": "foot -e nyx"
    },

    // ── I2P Status Indicator ─────────────────────────────────────
    "custom/i2p-status": {
        "exec": "/home/startalk/bin/i2p-status.sh",
        "interval": 30,
        "return-type": "json",
        "format": " {} ",
        "tooltip": true
    }
}
