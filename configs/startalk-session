#!/bin/bash
# ╔══════════════════════════════════════════════════════════════╗
# ║     Star-Talk / 星语 — Session Launcher                    ║
# ╚══════════════════════════════════════════════════════════════╝
#
# This script launches the full Star-Talk Wayland desktop session.
# Called from ~/.bash_profile on tty1 auto-login.
# Installed at /usr/local/bin/startalk-session

set -e

# ── Session type ─────────────────────────────────────────────────
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_DESKTOP=niri

# ── Wayland environment variables ────────────────────────────────
export MOZ_ENABLE_WAYLAND=1           # Firefox native Wayland
export QT_QPA_PLATFORM=wayland       # Qt apps on Wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND=wayland           # GTK apps on Wayland
export SDL_VIDEODRIVER=wayland       # SDL2 games on Wayland
export CLUTTER_BACKEND=wayland       # Clutter on Wayland
export ELM_ENGINE=wayland_shm        # EFL on Wayland
export ECORE_EVAS_ENGINE=wayland_shm # EFL on Wayland

# ── Toolkit debugging (disable for release) ──────────────────────
# export WAYLAND_DEBUG=1

# ── XDG directories ──────────────────────────────────────────────
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
chmod 700 "$XDG_RUNTIME_DIR" 2>/dev/null || true

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# ── Start audio server ───────────────────────────────────────────
if [ -x /usr/bin/pipewire ]; then
    /usr/bin/pipewire &
    PIPEWIRE_PID=$!
fi

if [ -x /usr/bin/wireplumber ]; then
    /usr/bin/wireplumber &
    WIREPLUMBER_PID=$!
fi

# Wait for PipeWire socket
sleep 1

# ── Start notification daemon ────────────────────────────────────
# mako is auto-started by Niri's spawn-at-startup

# ── Launch Niri compositor ───────────────────────────────────────
if [ -x /usr/bin/niri ]; then
    echo "Launching Niri (scrollable-tiling Wayland compositor)..."
    exec /usr/bin/niri --session
else
    echo "ERROR: Niri not found at /usr/bin/niri"
    echo "Falling back to shell..."
    exec /bin/bash
fi
