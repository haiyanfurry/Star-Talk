#
# Filesystem mount table for the live system.
# The rootfs is already mounted by initramfs before switch_root.
# These are additional runtime mounts.

# Virtual filesystems
proc     /proc      proc      defaults,nosuid,nodev,noexec,relatime  0 0
sysfs    /sys       sysfs     defaults,nosuid,nodev,noexec,relatime  0 0
devtmpfs /dev       devtmpfs  defaults,nosuid,relatime,size=2M       0 0
tmpfs    /run       tmpfs     defaults,nosuid,nodev,relatime,size=128M 0 0
tmpfs    /tmp       tmpfs     defaults,nosuid,nodev,relatime,size=512M 0 0
tmpfs    /var/log   tmpfs     defaults,nosuid,nodev,relatime,size=64M  0 0

# EFI System Partition (if present, detected by UUID or label)
# LABEL=STARTALK_EFI  /boot/efi  vfat  defaults,noatime  0 1
