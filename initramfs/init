#!/bin/busybox sh
# ╔══════════════════════════════════════════════════════════════╗
# ║     Star-Talk / 星语 — Initramfs /init                      ║
# ║     AIX-Style Boot Sequence                                 ║
# ╚══════════════════════════════════════════════════════════════╝
#
# This script runs as PID 1 inside the initramfs.
# Responsibilities:
#   1. Mount virtual filesystems (proc, sys, dev, tmpfs)
#   2. Display AIX-style welcome screen with hardware detection
#   3. Locate and mount the root filesystem
#   4. Set up overlay for persistence (optional)
#   5. switch_root to the real init

# ── Shell setup ─────────────────────────────────────────────────
set -o pipefail 2>/dev/null || true

# ── ANSI color definitions ──────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'
C_CYAN='\033[1;36m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_RED='\033[1;31m'
C_BLUE='\033[1;34m'
C_MAGENTA='\033[1;35m'
C_WHITE='\033[1;37m'
C_GRAY='\033[0;37m'

# ── Phase 1: Mount virtual filesystems ─────────────────────────
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /run /tmp
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null

# ── Phase 2: Parse kernel command line ──────────────────────────
ROOT_DEV=""
ROOT_TYPE="auto"
PERSISTENCE=""
SHELL_ON_ERROR=""
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        root=*)      ROOT_DEV="${arg#root=}" ;;
        rootfstype=*) ROOT_TYPE="${arg#rootfstype=}" ;;
        persistence) PERSISTENCE="yes" ;;
        star-talk.debug) set -x; SHELL_ON_ERROR="yes" ;;
        star-talk.shell) SHELL_ON_ERROR="yes" ;;
        star-talk.nosplash) QUIET_BOOT="yes" ;;
        ro)          READONLY="yes" ;;
        rw)          READONLY="" ;;
        quiet)       QUIET_BOOT="yes" ;;
    esac
done

# ── Phase 3: AIX-style welcome screen ───────────────────────────
if [ -z "$QUIET_BOOT" ]; then
    # Hardware discovery
    CPU_MODEL=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^[ \t]*//')
    [ -z "$CPU_MODEL" ] && CPU_MODEL="$(grep "Model" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^[ \t]*//')"
    [ -z "$CPU_MODEL" ] && CPU_MODEL="Unknown CPU"

    CPU_CORES=$(grep -c "^processor" /proc/cpuinfo 2>/dev/null)
    [ -z "$CPU_CORES" ] && CPU_CORES="?"

    TOTAL_RAM=$(awk '/MemTotal/ {printf "%d MB", $2/1024}' /proc/meminfo 2>/dev/null)
    [ -z "$TOTAL_RAM" ] && TOTAL_RAM="unknown"

    # GPU detection via sysfs
    GPU_INFO=""
    for card in /sys/class/drm/card*; do
        if [ -d "$card" ]; then
            DRIVER=$(cat "$card/device/uevent" 2>/dev/null | grep "DRIVER=" | head -1 | cut -d= -f2)
            [ -z "$DRIVER" ] && DRIVER="unknown"
            CARD_NUM=$(basename "$card" | sed 's/card//')
            GPU_INFO="${GPU_INFO}card${CARD_NUM}:${DRIVER} "
        fi
    done
    [ -z "$GPU_INFO" ] && GPU_INFO="probing via DRM..."

    KERNEL_VER=$(uname -r)

    # AIX-style banner: Cyan box with ASCII art
    clear 2>/dev/null || printf '\033[2J\033[H'

    printf "${C_CYAN}"
    printf "  ╔══════════════════════════════════════════════════════════════╗\n"
    printf "  ║                                                              ║\n"
    printf "  ║${C_WHITE}         .d8888b.  888                      888    888       ${C_CYAN}║\n"
    printf "  ║${C_WHITE}        d88P  Y88b 888                      888    888       ${C_CYAN}║\n"
    printf "  ║${C_WHITE}        Y88b.      888                      888    888       ${C_CYAN}║\n"
    printf "  ║${C_WHITE}         \"Y888b.   888888  8888b.  888d888  888888 888  888  ${C_CYAN}║\n"
    printf "  ║${C_WHITE}            \"Y88b. 888        \"88b 888P\"    888    888  888  ${C_CYAN}║\n"
    printf "  ║${C_WHITE}              \"888 888    .d888888 888      888    888  888  ${C_CYAN}║\n"
    printf "  ║${C_WHITE}        Y88b  d88P Y88b.  888  888 888      Y88b.  Y88b 888  ${C_CYAN}║\n"
    printf "  ║${C_WHITE}         \"Y8888P\"   \"Y888 \"Y888888 888       \"Y888  \"Y88888  ${C_CYAN}║\n"
    printf "  ║                                                              ║\n"
    printf "  ║${C_YELLOW}            ★  Welcome to Star-Talk / 星语  ★              ${C_CYAN}║\n"
    printf "  ║${C_GREEN}            Linux 7.0.12 Live Environment                   ${C_CYAN}║\n"
    printf "  ║                                                              ║\n"
    printf "  ╚══════════════════════════════════════════════════════════════╝\n"
    printf "${RESET}\n"

    # Hardware telemetry panel (AIX-style)
    printf "${C_CYAN}  ┌── ${C_WHITE}Hardware Detection${C_CYAN} ──────────────────────────────────────┐\n"
    printf "${C_CYAN}  │${RESET}  ${C_GREEN}CPU      :${RESET} %-47s ${C_CYAN}│\n" "${CPU_MODEL}"
    printf "${C_CYAN}  │${RESET}  ${C_GREEN}Cores    :${RESET} %-47s ${C_CYAN}│\n" "${CPU_CORES}"
    printf "${C_CYAN}  │${RESET}  ${C_GREEN}Memory   :${RESET} %-47s ${C_CYAN}│\n" "${TOTAL_RAM}"
    printf "${C_CYAN}  │${RESET}  ${C_GREEN}GPU      :${RESET} %-47s ${C_CYAN}│\n" "${GPU_INFO}"
    printf "${C_CYAN}  │${RESET}  ${C_GREEN}Kernel   :${RESET} %-47s ${C_CYAN}│\n" "Linux ${KERNEL_VER}"
    printf "${C_CYAN}  └──────────────────────────────────────────────────────────────┘\n"
    printf "${RESET}\n"
fi

# ── Phase 4: Wait and detect devices ────────────────────────────
# Allow USB/disk devices to settle
sleep 1

# Populate /dev with device nodes (if not using devtmpfs fully)
mdev -s 2>/dev/null || true

# Load essential kernel modules
modprobe ext4 2>/dev/null || true
modprobe vfat 2>/dev/null || true
modprobe squashfs 2>/dev/null || true
modprobe overlay 2>/dev/null || true
modprobe usb-storage 2>/dev/null || true
modprobe xhci-pci 2>/dev/null || true
modprobe nvme 2>/dev/null || true
modprobe virtio-blk 2>/dev/null || true
modprobe sd-mod 2>/dev/null || true

# Second device settle after module loading
sleep 1

# ── Phase 5: Locate root device ─────────────────────────────────
find_root_device() {
    # Priority 1: Explicit device from kernel cmdline
    if [ -n "$ROOT_DEV" ] && [ -b "$ROOT_DEV" ]; then
        echo "$ROOT_DEV"
        return 0
    fi

    # Priority 2: PARTLABEL / LABEL search (if blkid available)
    if command -v blkid >/dev/null 2>&1; then
        ROOT=$(blkid -L "STARTALK_ROOT" 2>/dev/null)
        [ -n "$ROOT" ] && [ -b "$ROOT" ] && { echo "$ROOT"; return 0; }
        ROOT=$(blkid -t PARTLABEL="STARTALK_ROOT" -o device 2>/dev/null | head -1)
        [ -n "$ROOT" ] && [ -b "$ROOT" ] && { echo "$ROOT"; return 0; }
    fi

    # Priority 3: Scan common paths
    for dev in /dev/sda2 /dev/sdb2 /dev/sdc2 /dev/sdd2 \
               /dev/nvme0n1p2 /dev/nvme1n1p2 \
               /dev/vda2 /dev/vdb2 \
               /dev/mmcblk0p2 /dev/mmcblk1p2; do
        [ -b "$dev" ] && { echo "$dev"; return 0; }
    done

    # Priority 4: Any ext4/vfat partition at index 2
    for disk in /dev/sd? /dev/vd? /dev/nvme?n?; do
        PART="${disk}2"
        [ -b "$PART" ] || PART="${disk}p2"
        [ -b "$PART" ] && { echo "$PART"; return 0; }
    done 2>/dev/null

    return 1
}

ROOT_PART=$(find_root_device)

if [ -z "$ROOT_PART" ]; then
    printf "${C_RED}  ERROR: Could not find root device (LABEL=STARTALK_ROOT)${RESET}\n"
    printf "${C_YELLOW}  Available block devices:${RESET}\n"
    ls -la /dev/sd* /dev/vd* /dev/nvme* /dev/mmcblk* 2>/dev/null | while read -r line; do
        printf "    %s\n" "$line"
    done
    echo ""
    if [ -n "$SHELL_ON_ERROR" ]; then
        printf "${C_YELLOW}  Dropping to emergency shell...${RESET}\n"
        exec /bin/sh
    else
        printf "${C_YELLOW}  Rebooting in 10 seconds...${RESET}\n"
        sleep 10
        reboot -f 2>/dev/null || halt -f
    fi
fi

# ── Phase 6: Mount root filesystem ──────────────────────────────
mkdir -p /mnt/root

printf "${C_CYAN}  ┌── ${C_WHITE}Mounting Root Filesystem${C_CYAN} ─────────────────────────────┐\n"
printf "${C_CYAN}  │${RESET}  Device   : %-49s ${C_CYAN}│\n" "$ROOT_PART"

MOUNT_OK=""
ROOT_TYPE_ACTUAL=""

# Strategy 1: Try SquashFS loop mount
if [ "$ROOT_TYPE" = "auto" ] || [ "$ROOT_TYPE" = "squashfs" ]; then
    # First, try direct squashfs mount (if the partition IS squashfs)
    if mount -t squashfs -o ro "$ROOT_PART" /mnt/root 2>/dev/null; then
        ROOT_TYPE_ACTUAL="squashfs (direct)"
        MOUNT_OK="yes"
    fi
fi

# Strategy 2: Try ext4
if [ -z "$MOUNT_OK" ]; then
    if [ "$ROOT_TYPE" = "auto" ] || [ "$ROOT_TYPE" = "ext4" ]; then
        if mount -t ext4 -o "${READONLY:+ro,}noatime" "$ROOT_PART" /mnt/root 2>/dev/null; then
            ROOT_TYPE_ACTUAL="ext4"
            MOUNT_OK="yes"
        fi
    fi
fi

# Strategy 3: Try as ext4 containing squashfs file
if [ -z "$MOUNT_OK" ]; then
    # Mount the partition as ext4 to a temp location and loop-mount the squashfs inside
    mkdir -p /mnt/rootpart
    if mount -t ext4 -o ro,noatime "$ROOT_PART" /mnt/rootpart 2>/dev/null; then
        SQUASHFS_FILE=$(ls /mnt/rootpart/*.squashfs /mnt/rootpart/rootfs.sqfs 2>/dev/null | head -1)
        if [ -n "$SQUASHFS_FILE" ]; then
            if mount -t squashfs -o ro,loop "$SQUASHFS_FILE" /mnt/root 2>/dev/null; then
                ROOT_TYPE_ACTUAL="squashfs (loop from ext4)"
                MOUNT_OK="yes"
            fi
        fi
        # Keep rootpart mounted if overlay needed later
    fi
fi

if [ -z "$MOUNT_OK" ]; then
    printf "${C_CYAN}  │${C_RED}  ERROR: Failed to mount root filesystem${C_CYAN}              │\n"
    printf "${C_CYAN}  └──────────────────────────────────────────────────────────────┘\n${RESET}\n"
    if [ -n "$SHELL_ON_ERROR" ]; then
        exec /bin/sh
    else
        echo "Rebooting in 10 seconds..."
        sleep 10
        reboot -f 2>/dev/null || halt -f
    fi
fi

printf "${C_CYAN}  │${RESET}  Type     : %-49s ${C_CYAN}│\n" "$ROOT_TYPE_ACTUAL"

# ── Phase 7: Overlay setup for writable layer ──────────────────
if echo "$ROOT_TYPE_ACTUAL" | grep -q "squashfs"; then
    if [ -n "$PERSISTENCE" ]; then
        # Persistence: use dedicated persistence partition as overlay upperdir
        PERSIST_PART=""
        if command -v blkid >/dev/null 2>&1; then
            PERSIST_PART=$(blkid -L "STARTALK_PERSIST" 2>/dev/null)
        fi
        if [ -n "$PERSIST_PART" ] && [ -b "$PERSIST_PART" ]; then
            mkdir -p /mnt/persist /mnt/overlay
            mount "$PERSIST_PART" /mnt/persist 2>/dev/null || true
            mkdir -p /mnt/persist/upper /mnt/persist/work 2>/dev/null
            if mount -t overlay overlay \
                -o "lowerdir=/mnt/root,upperdir=/mnt/persist/upper,workdir=/mnt/persist/work" \
                /mnt/overlay 2>/dev/null; then
                umount /mnt/root 2>/dev/null
                mount --move /mnt/overlay /mnt/root 2>/dev/null
                ROOT_TYPE_ACTUAL="${ROOT_TYPE_ACTUAL} + overlay (persistent)"
            else
                printf "${C_CYAN}  │${C_YELLOW}  Note: persistence mount failed, using tmpfs overlay${C_CYAN}  │\n"
                PERSISTENCE="fallback"
            fi
        else
            printf "${C_CYAN}  │${C_YELLOW}  Note: no persistence partition found${C_CYAN}                 │\n"
            PERSISTENCE="fallback"
        fi
    fi

    # Volatile overlay (tmpfs) if no persistence or persistence failed
    if [ -z "$PERSISTENCE" ] || [ "$PERSISTENCE" = "fallback" ]; then
        mkdir -p /tmp/overlay/upper /tmp/overlay/work /mnt/overlay 2>/dev/null
        if mount -t overlay overlay \
            -o "lowerdir=/mnt/root,upperdir=/tmp/overlay/upper,workdir=/tmp/overlay/work" \
            /mnt/overlay 2>/dev/null; then
            umount /mnt/root 2>/dev/null
            mount --move /mnt/overlay /mnt/root 2>/dev/null
            ROOT_TYPE_ACTUAL="${ROOT_TYPE_ACTUAL} + overlay (volatile tmpfs)"
        fi
    fi
fi

printf "${C_CYAN}  │${RESET}  Final    : %-49s ${C_CYAN}│\n" "$ROOT_TYPE_ACTUAL"
printf "${C_CYAN}  └──────────────────────────────────────────────────────────────┘\n${RESET}\n"

# ── Phase 8: Switch to real root ────────────────────────────────
printf "${C_GREEN}  Switching to real root...${RESET}\n"

# Move virtual filesystems into new root
for fs in dev proc sys run tmp; do
    if mountpoint -q /$fs 2>/dev/null; then
        mount --move /$fs /mnt/root/$fs 2>/dev/null || \
            mount -o bind /$fs /mnt/root/$fs 2>/dev/null || true
    fi
done

# Ensure important mount points exist in rootfs
mkdir -p /mnt/root/dev /mnt/root/proc /mnt/root/sys /mnt/root/run /mnt/root/tmp 2>/dev/null

# Execute the real init
exec switch_root /mnt/root /sbin/init

# If switch_root fails, fallback
printf "${C_RED}  switch_root failed! Dropping to emergency shell...${RESET}\n"
exec /bin/sh
